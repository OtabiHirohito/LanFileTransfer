<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LanFileTransfer</RootNamespace>
    <AssemblyName>LanFileTransfer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>LanFileTransfer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="LanFileTransfer.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.3" />
  </ItemGroup>

</Project>
